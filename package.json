{
  "name": "zendesk-clown",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:widget && react-router build",
    "dev": "react-router dev",
    "start": "dotenv -e .env.local -- react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:types": "supabase gen types typescript --project-id hoalkqukcfppaurrlicw > app/lib/db/database.types.ts",
    "build:widget": "vite build --config vite.widget.config.ts",
    "widget:dev": "npm run build:widget && npx serve public -l 5174 --cors"
  },
  "dependencies": {
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
